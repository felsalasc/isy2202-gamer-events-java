# Contraseña para las cuentas demo 
# Cuentas generadas automáticamente:
# - gamer1@example.test
# - gamer2@example.test
# - gamer3@example.test
GAMER_DEMO_PASSWORD=EvaluacionDuoc2026!

# Secreto para firmar los tokens JWT (HS256): mínimo 32 bytes, nunca en Git.
# Genera uno con: openssl rand -base64 48
JWT_SECRET=

# Base de datos MySQL (docker compose crea la base y el usuario con estos valores).
DB_NAME=gamer_events
DB_USERNAME=gamer_events
# Contraseñas de MySQL: usa valores propios y largos. Genera uno con: openssl rand -base64 24
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
